@using Perfume_King.Blazor.Components
@using Perfume_King.Shared.Services
@implements IDisposable
@inject ICartService CartService

<style>
    .white-placeholder::placeholder {
        color: rgba(255, 255, 255, 0.75) !important;
        opacity: 1 !important;
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top px-3 py-2 border-bottom border-secondary border-opacity-25">
    <div class="container-fluid">

        <NavLink class="navbar-brand fw-bold text-uppercase tracking-wider fs-4 text-warning" href="">
            Perfume King
        </NavLink>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavbar" aria-controls="mobileNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="mobileNavbar">

            <div class="offcanvas-header border-bottom border-secondary border-opacity-25">
                <span class="navbar-brand fw-bold text-uppercase tracking-wider text-warning m-0">Perfume King</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <div class="offcanvas-body p-4 p-lg-0">
                <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center w-100 gap-4 gap-lg-0">

                    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-3 ms-lg-4 me-lg-auto w-100-sm">
                        <NavLink class="nav-link text-white-50 fw-medium text-uppercase small tracking-wide py-1" href="/location">
                            <i class="bi bi-geo-alt me-1"></i> @SharedResource.Location
                        </NavLink>
                    </div>

                    <div class="mx-auto my-3 my-lg-0 w-100" style="max-width: 500px;">
                        <form class="position-relative w-100" role="search">
                            <input class="form-control white-placeholder bg-secondary bg-opacity-25 text-white border-0 rounded-pill ps-4 pe-5 py-2 shadow-none" type="search" placeholder="@SharedResource.SearchFragrancesPlaceholder" aria-label="Search">
                            <button class="btn text-white-50 position-absolute end-0 top-50 translate-middle-y border-0 pe-3 bg-transparent h-100 d-flex align-items-center" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>
                    </div>

                    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-4 ms-lg-auto w-100-sm justify-content-end">
                        <CultureSelector />

                        @if (UserStateManager.IsLoggedIn)
                        {
                            <NavLink class="nav-link text-white-50 fw-medium small text-uppercase" href="profile">@SharedResource.Profile</NavLink>
                            <NavLink class="nav-link text-white-50 fw-medium small text-uppercase" href="orders">@SharedResource.Orders</NavLink>
                            <NavLink class="nav-link text-white position-relative fw-bold small text-uppercase" href="cart">
                                @SharedResource.ShoppingCart <span class="badge bg-warning text-dark rounded-pill ms-1">@UserStateManager.CartItemsCount</span>
                            </NavLink>
                            <button class="nav-link btn btn-link text-danger fw-bold small text-uppercase p-0 border-0 align-baseline" @onclick="HandleLogout">
                                @SharedResource.Logout
                            </button>
                        }
                        else
                        {
                            <NavLink class="nav-link text-white-50 fw-medium small text-uppercase" href="login">@SharedResource.LoginButton</NavLink>
                        }
                    </div>

                </div>
            </div>

        </div>

    </div>
</nav>


@code {
    protected override void OnInitialized()
    {
        UserStateManager.OnStateChanged += RefreshNavbar;
    }

    private void RefreshNavbar() => StateHasChanged();

    private void HandleLogout()
    {
        UserStateManager.Logout();
    }

    public void Dispose()
    {
        UserStateManager.OnStateChanged -= RefreshNavbar;
    }
}
