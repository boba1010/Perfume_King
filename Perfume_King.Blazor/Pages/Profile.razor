@page "/Profile"
@using Shared.DTOs
@using Shared.Services
@inject IAuthService AuthService
@inject IUserService UserService
@inject NavigationManager Nav

<PageTitle>Profile -- Perfume King</PageTitle>

@if (!IsBusy)
{
    <div class="container my-4">
        <div class="row g-4">
        
            <div class="col-12 col-md-4">
                <div class="card bg-white p-3 border-0 shadow-sm">
                    <div class="card-body text-center text-md-start">
                        <div class="mb-3 text-center">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center text-secondary" style="width: 80px; height: 80px;">
                                <i class="bi bi-person-fill fs-1"></i>
                            </div>
                        </div>

                        <h4 class="fw-bold mb-1">@User.FullName</h4>
                        <p class="text-muted small mb-3">@User.Email</p>

                        <hr />

                        <!-- Phone Number Block -->
                        <div class="mb-3">
                            <small class="text-muted d-block">@SharedResource.PhoneNumber</small>
                            <div class="d-flex align-items-center justify-content-between justify-content-md-start gap-2">
                                @if (isEditingPhone)
                                {
                                    <input type="text" class="form-control form-control-sm w-auto" @bind="editedPhone" />
                                    <button class="btn btn-sm btn-dark px-2 py-1 lh-1" @onclick="SavePhone" title="Save">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border px-2 py-1 lh-1" @onclick="() => isEditingPhone = false" title="Cancel">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="fw-medium">@User.Phone</span>
                                    <button class="btn btn-link text-dark p-0 btn-sm text-decoration-none" @onclick="ToggleEditPhone" title="Edit Phone Number">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Address Block -->
                        <div class="mb-4">
                            <small class="text-muted d-block">@SharedResource.DeliveryAddress</small>
                            <div class="d-flex align-items-start justify-content-between justify-content-md-start gap-2">
                                @if (isEditingAddress)
                                {
                                    <input type="text" class="form-control form-control-sm" @bind="editedAddress" />
                                    <button class="btn btn-sm btn-dark px-2 py-1 lh-1" @onclick="SaveAddress" title="Save">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border px-2 py-1 lh-1" @onclick="() => isEditingAddress = false" title="Cancel">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="fw-medium">@User.Address</span>
                                    <button class="btn btn-link text-dark p-0 btn-sm text-decoration-none mt-1" @onclick="ToggleEditAddress" title="Edit Address">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <!-- City Block -->
                        <div class="mb-4">
                            <small class="text-muted d-block">@SharedResource.City / @SharedResource.Governorate</small>
                            <div class="d-flex align-items-start justify-content-between justify-content-md-start gap-2">
                                @if (isEditingCity)
                                {
                                    <div class="mb-3">
                                        <select class="form-select form-control form-control-sm" @bind="editedCity">
                                            <option selected>Cairo</option>
                                            <option>Giza</option>
                                            <option>Alexandria</option>
                                            <option>Other</option>
                                        </select>
                                    </div>
                                    <button class="btn btn-sm btn-dark px-2 py-1 lh-1" @onclick="SaveCity" title="Save">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border px-2 py-1 lh-1" @onclick="() => isEditingCity = false" title="Cancel">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="fw-medium">@User.City</span>
                                    <button class="btn btn-link text-dark p-0 btn-sm text-decoration-none mt-1" @onclick="ToggleEditCity" title="Edit City">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <button class="btn btn-outline-danger btn-sm w-100" @onclick="LogOut">
                            <i class="bi bi-box-arrow-right me-1"></i> @SharedResource.Logout
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-8">
                <div class="card bg-white p-3">
                    <div class="card-body">
                        <h4 class="fw-bold mb-3">@SharedResource.MyOrders</h4>
                    
                        @if (User.Orders != null && User.Orders.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var order in User.Orders)
                                {
                                    <div class="p-3 border rounded-3 bg-light">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <span class="fw-bold d-block">@string.Format(SharedResource.OrderHash, order.OrderNumber)</span>
                                                <small class="text-muted">@order.CreatedAt</small>
                                            </div>
                                            <div class="text-start text-sm-end">
                                                <span class="fw-bold d-block">@order.TotalPrice @SharedResource.CurrencySuffix</span>
                                                <span class="badge @(order.Status == OrderStatus.Delivered ? "bg-success" : "bg-warning text-dark")">
                                                    @order.Status.ToString()
                                                </span>
                                            </div>
                                        </div>
                                    
                                        <div class="mt-2 pt-2 border-top">
                                            <small>
                                                @SharedResource.ItemsLabel
                                            </small>
                                            <small class="text-muted">
                                                @string.Join(", ", order.Items.Select(i => $"{i.Quantity}x {i.Name}"))
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted my-3">@SharedResource.NoOrdersYet</p>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>    
}
else
{
    <div class="position-absolute top-50 start-50 translate-middle text-center">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    private UserProfileDTO User { get; set; } = new();
    private string? ErrorMsg { get; set; }
    private bool IsBusy { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsBusy = true;

        var authResponse = await AuthService.VerifyUserAsync();
        UserStateManager.IsLoggedIn = authResponse.Data;

        if (!UserStateManager.IsLoggedIn)
        {
            IsBusy = false;
            Nav.NavigateTo("/login");
            return;
        }

        var response = await UserService.GetUserProfileAsync();
        if (!response.IsSuccess)
        {
            IsBusy = false;
            ErrorMsg = response.ErrorMessage;
            return;
        }

        User = response.Data;

        IsBusy = false;
    }

    private bool isEditingPhone = false;
    private bool isEditingAddress = false;
    private bool isEditingCity = false;

    private string editedPhone = string.Empty;
    private string editedAddress = string.Empty;
    private string editedCity = string.Empty;

    private void ToggleEditPhone()
    {
        editedPhone = User.Phone;
        isEditingPhone = true;
    }

    private void ToggleEditAddress()
    {
        editedAddress = User.Address;
        isEditingAddress = true;
    }
    private void ToggleEditCity()
    {
        editedCity = User.City;
        isEditingCity = true;
    }

    private async Task SaveCity()
    {
        await UserService.UpdateUserProfileAsync(new()
        {
            Phone = User.Phone,
            Address = User.Address,
            City = editedCity
        });

        User.City = editedCity;
        isEditingCity = false;
    }

    private async Task SavePhone()
    {
        await UserService.UpdateUserProfileAsync(new()
        {
            Phone = editedPhone,
            Address = User.Address,
            City = User.City
        });
        Console.WriteLine(editedPhone);
        User.Phone = editedPhone;
        isEditingPhone = false;
    }

    private async Task SaveAddress()
    {
        await UserService.UpdateUserProfileAsync(new()
        {
            Phone = User.Phone,
            Address = editedAddress,
            City = User.City
        });

        User.Address = editedAddress;
        isEditingAddress = false;
    }

    private void LogOut()
    {
        UserStateManager.Logout();
    }
}
