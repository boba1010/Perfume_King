@implements IDisposable
@inject NavigationManager Navigation

<style>
    .white-placeholder::placeholder {
        color: rgba(255, 255, 255, 0.75) !important;
        opacity: 1 !important;
    }

    .dropdown-menu {
        border: none !important;
    }

    .dropdown-menu.show {
        display: block !important;
    }

    .offcanvas-body {
        overflow: visible !important;
    }

    @@media (min-width: 992px) {
        .dropdown-toggle::after {
            display: inline-block;
            margin-left: 0.255em;
            vertical-align: 0.255em;
            content: "";
            border-top: 0.3em solid;
            border-right: 0.3em solid transparent;
            border-bottom: 0;
            border-left: 0.3em solid transparent;
        }
    }

    @@media (max-width: 991.98px) {
        .w-100-sm {
            width: 100% !important;
        }

        .dropdown-menu.show {
            display: block !important;
            position: static !important;
            float: none !important;
            background-color: rgba(255, 255, 255, 0.03) !important;
            border: none !important;
            box-shadow: none !important;
            padding-left: 1.25rem !important;
            margin: 0.25rem 0 0 0 !important;
            border-radius: 8px !important;
        }

        .dropdown-toggle {
            display: flex !important;
            align-items: center;
            justify-content: space-between;
        }

        .dropdown-toggle::after {
            display: inline-block;
            content: "";
            border-top: 0.3em solid;
            border-right: 0.3em solid transparent;
            border-bottom: 0;
            border-left: 0.3em solid transparent;
            transition: transform 0.2s ease;
        }

        .dropdown-toggle[aria-expanded="true"]::after {
            transform: rotate(180deg);
        }

        .dropdown-item {
            padding: 0.5rem 0.75rem !important;
            color: rgba(255, 255, 255, 0.7) !important;
        }

        .dropdown-item:hover, .dropdown-item:focus {
            background-color: rgba(255, 255, 255, 0.08) !important;
            color: #fff !important;
        }
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top px-3 py-2 border-bottom border-secondary border-opacity-25">
    <div class="container-fluid">
        <NavLink class="navbar-brand fw-bold text-uppercase tracking-wider fs-4 text-warning d-flex align-items-center gap-2" href="/">
            Perfume King
            <span class="badge bg-danger text-white fs-6 uppercase font-monospace">ADMIN</span>
        </NavLink>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="mobileNavbar">
            <div class="offcanvas-header border-bottom border-secondary border-opacity-25">
                <span class="navbar-brand fw-bold text-uppercase tracking-wider text-warning m-0">Perfume King - ADMIN</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>
            </div>

            <div class="offcanvas-body p-4 p-lg-0">
                <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center w-100 gap-4 gap-lg-0">

                    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-3 ms-lg-4 me-lg-auto w-100-sm">

                        <div class="nav-item dropdown w-100-sm">
                            <button class="nav-link dropdown-toggle text-white-50 fw-medium text-uppercase small tracking-wide py-1 border-0 bg-transparent text-start w-100"
                                    id="perfumesDropdown"
                                    type="button"
                                    @onclick="TogglePerfumes"
                                    aria-expanded="@isPerfumesOpen.ToString().ToLower()">
                                <span><i class="bi bi-droplet-half me-1"></i> العطور</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark bg-dark border-secondary @(isPerfumesOpen ? "show" : "")" aria-labelledby="perfumesDropdown">
                                <li><a class="dropdown-item small text-uppercase" href="/perfumes"><i class="bi bi-list-ul me-2 text-info"></i> عرض جميع العطور</a></li>
                                <li><a class="dropdown-item small text-uppercase" href="/perfumes/create"><i class="bi bi-plus-circle me-2 text-success"></i> إضافة عطر جديد</a></li>
                            </ul>
                        </div>

                        <div class="nav-item dropdown w-100-sm">
                            <button class="nav-link dropdown-toggle text-white-50 fw-medium text-uppercase small tracking-wide py-1 border-0 bg-transparent text-start w-100"
                                    id="usersDropdown"
                                    type="button"
                                    @onclick="ToggleUsers"
                                    aria-expanded="@isUsersOpen.ToString().ToLower()">
                                <span><i class="bi bi-people me-1"></i> المستخدمون</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark bg-dark border-secondary @(isUsersOpen ? "show" : "")" aria-labelledby="usersDropdown">
                                <li><a class="dropdown-item small text-uppercase" href="/users"><i class="bi bi-person-lines-fill me-2 text-info"></i> إدارة جميع المستخدمين</a></li>
                            </ul>
                        </div>

                        <NavLink class="nav-link text-white-50 fw-medium text-uppercase small tracking-wide py-1 w-100-sm text-start" href="/orders">
                            <i class="bi bi-receipt me-1"></i> الطلبات
                        </NavLink>
                    </div>

                    <div class="mx-auto my-3 my-lg-0 w-100" style="max-width: 500px;">
                        <form class="position-relative w-100" role="search">
                            <input class="form-control white-placeholder bg-secondary bg-opacity-25 text-white border-0 rounded-pill ps-4 pe-5 py-2 shadow-none" type="search" placeholder="ابحث عن المنتجات أو الطلبات أو المستخدمين..." aria-label="بحث">
                            <button class="btn text-white-50 position-absolute end-0 top-50 translate-middle-y border-0 pe-3 bg-transparent h-100 d-flex align-items-center" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>
                    </div>

                    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-4 ms-lg-auto w-100-sm justify-content-lg-end justify-content-start">
                        @if (AdminStateManager.IsLoggedIn)
                        {
                            <button class="nav-link btn btn-link text-danger fw-bold small text-uppercase p-0 border-0 align-baseline w-100-sm text-start" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-1"></i> تسجيل الخروج
                            </button>
                        }
                        else
                        {
                            <NavLink class="nav-link text-white-50 fw-medium small text-uppercase w-100-sm text-start" href="/login">تسجيل الدخول</NavLink>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool isPerfumesOpen = false;
    private bool isUsersOpen = false;

    protected override void OnInitialized()
    {
        AdminStateManager.OnStateChanged += RefreshNavbar;
        Navigation.LocationChanged += CloseDropdownsOnNavigate;
    }

    private void TogglePerfumes()
    {
        isPerfumesOpen = !isPerfumesOpen;
        isUsersOpen = false;
    }

    private void ToggleUsers()
    {
        isUsersOpen = !isUsersOpen;
        isPerfumesOpen = false;
    }

    private void CloseDropdownsOnNavigate(object? sender, EventArgs e)
    {
        isPerfumesOpen = false;
        isUsersOpen = false;
        StateHasChanged();
    }

    private void RefreshNavbar()
    {
        StateHasChanged();
    }

    private void HandleLogout()
    {
        AdminStateManager.Logout();
    }

    public void Dispose()
    {
        AdminStateManager.OnStateChanged -= RefreshNavbar;
        Navigation.LocationChanged -= CloseDropdownsOnNavigate;
    }
}
