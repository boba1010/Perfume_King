@using Perfume_King.Shared.DTOs
<div class="col animate__animated animate__fadeIn">
    <div class="card h-100 bg-dark text-white border-secondary shadow-lg overflow-hidden position-relative transition-hover">

        <div class="position-absolute top-0 start-0 p-2 d-flex flex-column gap-1 align-items-start" style="z-index: 4;">
            <span class="badge @GetCategoryBadgeClass(Perfume.Category) px-2.5 py-1.5 shadow-sm text-uppercase fw-bold small rounded-2">
                @GetCategoryLabel(Perfume.Category)
            </span>
            @if (!Perfume.IsAvailable)
            {
                <span class="badge bg-danger px-2.5 py-1.5 shadow-sm fw-bold small rounded-2">غير متاح للبيع</span>
            }
        </div>

        <div class="position-relative overflow-hidden bg-black bg-opacity-50 w-100" style="aspect-ratio: 1/1;">
            <img src="@Perfume.ImageUri"
                 alt="@Perfume.Name"
                 class="w-100 h-100 position-absolute top-0 start-0 img-fluid"
                 style="object-fit: cover;"
                 onerror="this.src='https://placehold.co'" />
        </div>

        <div class="card-body p-3 d-flex flex-column justify-content-between">
            <div class="mb-3">
                <h5 class="card-title fw-bold text-warning text-truncate mb-1" title="@Perfume.Name">@Perfume.Name</h5>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="fs-5 fw-bold text-white text-nowrap">@Perfume.Price.ToString("N0") EGP</span>
                    <span class="text-white-50 small text-nowrap"><i class="bi bi-bag-check me-1"></i> @Perfume.SaleNumber</span>
                </div>
            </div>

            <div class="d-flex flex-column flex-xs-row gap-2 border-top border-secondary pt-3 mt-auto">
                <NavLink href="@($"/perfumes/edit?perfumeid={Perfume.Id}")" class="btn btn-outline-info flex-grow-1 btn-sm fw-bold d-inline-flex align-items-center justify-content-center gap-1 py-2">
                    <i class="bi bi-pencil-square"></i>
                    <span>تعديل</span>
                </NavLink>
                <button class="btn btn-outline-danger flex-grow-1 btn-sm fw-bold d-inline-flex align-items-center justify-content-center gap-1 py-2"
                        @onclick="() => DeleteRequestAsnyc(Perfume)">
                    <i class="bi bi-trash3-fill"></i>
                    <span>حذف</span>
                </button>
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter] public EventCallback<PerfumeDTO> DeleteRequest { get; set; }
    [Parameter] public PerfumeDTO Perfume { get; set; }

    private async Task DeleteRequestAsnyc(PerfumeDTO item) => await DeleteRequest.InvokeAsync(item);

    private string GetCategoryLabel(Category category) => category switch
    {
        Category.Men => "رجالي (Men)",
        Category.Women => "نسائي (Women)",
        Category.Unisex => "مناسب للجنسين (Unisex)",
        _ => category.ToString()
    };

    private string GetCategoryBadgeClass(Category category) => category switch
    {
        Category.Men => "bg-primary text-white",
        Category.Women => "bg-danger text-white",
        Category.Unisex => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };
}
