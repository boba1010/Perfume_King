@using Perfume_King.Shared.DTOs

<div class="mt-4 pt-3 border-top border-secondary animate__animated animate__fadeIn">
    <h6 class="text-warning fw-bold mb-3"><i class="bi bi-box-seam me-1"></i> تفاصيل المنتجات داخل الطلب</h6>
    <div class="table-responsive rounded border border-secondary overflow-hidden">
        <table class="table table-dark table-hover align-middle mb-0 text-center">
            <thead class="table-black text-white-50 small">
                <tr>
                    <th scope="col" class="text-start ps-4">العطر</th>
                    <th scope="col">السعر الفردي</th>
                    <th scope="col">الكمية</th>
                    <th scope="col" class="text-end pe-4">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        <td class="text-start ps-4 fw-semibold text-warning">@item.Name</td>
                        <td>@item.Price.ToString("N0") EGP</td>
                        <td><span class="badge bg-secondary px-2">@($"x{item.Quantity}")</span></td>
                        <td class="text-end pe-4 fw-bold">@((item.Price * item.Quantity).ToString("N0")) EGP</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public List<OrderItemDTO> Items { get; set; } = new();
}
