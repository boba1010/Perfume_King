@using Perfume_King.Shared.DTOs
<div class="card bg-dark text-white border-secondary shadow-lg overflow-hidden transition-hover-card w-100" dir="rtl">
    <div class="card-body p-3 p-md-4">
        <div class="row g-4 align-items-center">

            <!-- Primary Identification Column -->
            <div class="col-12 col-md-4 border-md-end-secondary pb-3 pb-md-0 d-flex align-items-center gap-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-black bg-opacity-40 border border-secondary rounded-circle shadow-sm flex-shrink-0" style="width: 54px; height: 54px;">
                    <i class="bi bi-person-badge-fill text-warning fs-4"></i>
                </div>
                <div class="overflow-hidden">
                    <h5 class="text-white fw-bold mb-1 text-truncate" title="@User.FullName">@User.FullName</h5>
                    <span class="badge bg-secondary px-2.5 py-1.5 fw-bold small rounded-2 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-geo-alt-fill text-warning"></i> <span>@User.City</span>
                    </span>
                </div>
            </div>

            <!-- Contact Metadata Column -->
            <div class="col-12 col-sm-6 col-md-4 border-md-end-secondary py-2 py-md-0">
                <h6 class="text-warning fw-bold small mb-2 d-flex align-items-center gap-1.5">
                    <i class="bi bi-envelope-at"></i>
                    <span>بيانات الاتصال</span>
                </h6>
                <div class="text-white-50 small mb-1 text-truncate" title="@User.Email">@User.Email</div>
                <div class="text-white-50 small fw-mono">@User.Phone</div>
            </div>

            <!-- Address Configuration & Control Actions Column -->
            <div class="col-12 col-sm-6 col-md-4 d-flex flex-column justify-content-between align-items-stretch gap-3 pt-2 pt-sm-0">
                <div class="overflow-hidden pe-md-2">
                    <h6 class="text-warning fw-bold small mb-1 d-flex align-items-center gap-1.5">
                        <i class="bi bi-house-door"></i>
                        <span>عنوان الشحن</span>
                    </h6>
                    <div class="text-white-50 small text-wrap text-break text-truncate-2" title="@User.Address">@User.Address</div>
                </div>

                <div class="d-flex gap-2 justify-content-start justify-content-sm-end mt-1 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-danger fw-semibold px-3 py-2 d-inline-flex align-items-center justify-content-center gap-1.5 flex-grow-1 flex-sm-grow-0"
                            @onclick="OnDelete"
                            disabled="@IsUpdating">
                        @if (IsUpdating)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash3-fill"></i>
                            <span>حذف</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Hardware-accelerated luxury hover states */
    .transition-hover-card {
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
    }

        .transition-hover-card:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 193, 7, 0.35) !important;
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.4) !important;
        }

    /* Strict clamp fallback line utilities */
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Column separating divider anchors corrected for RTL layouts */
    @@media (min-width: 768px) {
        .border-md-end-secondary {
            border-left: 1px solid rgba(255, 255, 255, 0.1) !important;
        }
    }
</style>

@code {
    [Parameter] public UserDTO User { get; set; } = default!;
    [Parameter] public bool IsUpdating { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}
