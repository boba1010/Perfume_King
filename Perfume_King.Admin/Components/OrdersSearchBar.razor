@using Perfume_King.Shared.DTOs

<div class="card bg-dark text-white border-secondary mb-4 shadow-sm overflow-hidden">
    <div class="card-body p-3 p-md-4">
        <div class="row g-3">
            <div class="col-12 col-md-7 col-lg-8">
                <div class="input-group input-group-lg-down">
                    <span class="input-group-text bg-black border-secondary border-start-0 text-white-50 px-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" 
                           class="form-control bg-black text-white border-secondary border-end-0 shadow-none ps-3 pe-0 custom-placeholder" 
                           placeholder="ابحث باسم العميل أو رقم الطلب..." 
                           @bind-value="Query" 
                           @bind-value:event="oninput" />
                </div>
            </div>
            <div class="col-12 col-md-5 col-lg-4">
                <select class="form-select form-select-lg-down bg-black text-white border-secondary shadow-none pe-3" 
                        @bind="Filter">
                    <option value="All" class="bg-dark">جميع الحالات</option>
                    @foreach (var status in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@status.ToString()" class="bg-dark">@GetStatusLabel(status)</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Query { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> QueryChanged { get; set; }
    
    [Parameter] public string Filter { get; set; } = "All";
    [Parameter] public EventCallback<string> FilterChanged { get; set; }

    [Parameter] public Func<OrderStatus, string> GetStatusLabel { get; set; } = default!;
}
