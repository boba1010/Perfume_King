@using Perfume_King.Shared.DTOs

<div class="card bg-dark text-white border-secondary shadow-lg overflow-hidden transition-hover-card mb-3 mb-md-4 w-100" dir="rtl">

    <div class="card-header bg-black bg-opacity-30 border-secondary p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex flex-wrap align-items-center gap-2 gap-sm-3">
            <span class="text-warning fw-bold fs-5">#@Order.OrderNumber</span>
            <span class="text-white-50 small text-nowrap"><i class="bi bi-calendar3 me-1"></i> @Order.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
            <span class="badge @GetStatusBadgeClass(Order.Status) px-2.5 py-1.5 fw-bold small rounded-2">
                @GetStatusLabel(Order.Status)
            </span>
        </div>
        <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-4 w-100 w-md-auto border-top border-secondary border-md-0 pt-2 pt-md-0">
            <div class="text-md-end">
                <span class="text-white-50 small d-block">إجمالي الحساب</span>
                <span class="fs-5 fw-bold text-warning text-nowrap">@Order.Items.Sum(item => item.Price * item.Quantity).ToString("N0") EGP</span>
            </div>
            <button class="btn btn-sm btn-outline-secondary text-white-50 border-secondary px-2" @onclick="OnToggleExpand">
                <i class="bi @(IsExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-3 p-md-4">
        <div class="row g-3 align-items-stretch">
            <div class="col-12 col-md-4 border-md-left-secondary pb-3 pb-md-0">
                <h6 class="text-warning fw-bold mb-2"><i class="bi bi-person-circle me-1"></i> بيانات العميل</h6>
                <div class="text-white small mb-1 fw-semibold text-truncate">@Order.CustomerName</div>
                <div class="text-white-50 small mb-1">@Order.Phone</div>
                <div class="text-white-50 small text-wrap text-break">@Order.Address</div>
            </div>

            <div class="col-12 col-md-4 border-md-left-secondary py-3 py-md-0">
                <h6 class="text-warning fw-bold mb-2"><i class="bi bi-truck me-1"></i> الشحن والتوصيل</h6>
                <div class="text-white-50 small mb-1">طريقة الدفع: <span class="text-white fw-semibold">@Order.PaymentMethod</span></div>
                <div class="text-white-50 small">العناصر المشتراة: <span class="badge bg-secondary">@Order.Items.Sum(i => i.Quantity) قطع</span></div>
            </div>

            <div class="col-12 col-md-4 text-md-center d-flex flex-column justify-content-center pt-3 pt-md-0">
                <label class="form-label text-white-50 small text-uppercase fw-semibold mb-2 d-block">تحديث حالة الطلب</label>
                <div class="d-flex gap-2 justify-content-md-center align-items-center">
                    <select class="form-select form-select-sm bg-black text-white border-secondary shadow-none w-100 w-md-auto d-inline-block py-2 px-3"
                            value="@Order.Status.ToString()"
                            @onchange="OnStatusChanged">
                        @foreach (var status in Enum.GetValues<OrderStatus>())
                        {
                            <option value="@status.ToString()" class="bg-dark">@GetStatusLabel(status)</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        @if (IsExpanded)
        {
            <OrderItemsTable Items="@Order.Items" />
        }
    </div>

</div>

@code {
    [Parameter] public OrderRequestDTO Order { get; set; } = default!;
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback OnToggleExpand { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnStatusChanged { get; set; }

    [Parameter] public Func<OrderStatus, string> GetStatusLabel { get; set; } = default!;
    [Parameter] public Func<OrderStatus, string> GetCategoryBadgeClass { get; set; } = default!;
    [Parameter] public Func<OrderStatus, string> GetStatusBadgeClass { get; set; } = default!;
}
