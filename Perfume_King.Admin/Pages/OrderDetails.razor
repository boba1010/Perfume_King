@page "/order-details"
@using Perfume_King.Shared.DTOs
@using Shared.Services
@inject IOrderService OrderService
@inject NavigationManager Nav
@inject IAuthService AuthService

<PageTitle>Perfume King -- Order Details</PageTitle>

@if (!IsBusy)
{
    @if (OrderRequest != null)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h4 class="mb-1 text-dark fw-bold">تفاصيل الطلب</h4>
                        <div class="text-muted small">
                            <span class="me-3"><strong>رقم الطلب:</strong> @OrderRequest.OrderNumber</span>
                            <span><strong>تاريخ الطلب:</strong> @OrderRequest.CreatedAt.ToString("MMMM dd, yyyy - hh:mm tt")</span>
                        </div>
                    </div>
                    <span class="badge fs-6 @GetStatusBadgeClass(OrderRequest.Status)">
                        @OrderRequest.Status
                    </span>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-2 text-secondary">معلومات العميل</h6>
                            <p class="mb-1 text-dark"><strong>الاسم:</strong> @OrderRequest.CustomerName</p>
                            <p class="mb-0 text-dark"><strong>الهاتف:</strong> @OrderRequest.Phone</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <h6 class="fw-bold mb-2 text-secondary">عنوان التوصيل</h6>
                            <p class="mb-1 text-dark">@OrderRequest.Address</p>
                            <p class="mb-0 text-dark">@OrderRequest.City</p>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold mb-3 text-secondary">Order Items (@OrderRequest.Items.Count)</h6>
                <div class="table-responsive border rounded-3 mb-4">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">اسم العطر</th>
                                <th class="text-center" style="width: 120px;">السعر</th>
                                <th class="text-center" style="width: 100px;">الكمية</th>
                                <th class="text-end pe-3" style="width: 150px;">المجموع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in OrderRequest.Items)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@item.Name</td>
                                    <td class="text-center text-muted">@item.Price EGP</td>
                                    <td class="text-center bg-light fw-bold text-dark">@item.Quantity</td>
                                    <td class="text-end pe-3 fw-bold text-dark">
                                        @((item.Price * item.Quantity)) جنيه
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- 4. Financial Bottom Line -->
                <div class="row justify-content-end">
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center p-3 border rounded-3 bg-dark text-white">
                            <span class="fs-6 text-light">الاجمالي:</span>
                            <span class="fs-4 fw-bold">@OrderRequest.TotalPrice جنيه</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="card bg-white p-5 text-center my-4 border-0 shadow-sm">
            <div class="mb-3 text-secondary">
                <i class="bi bi-box2-open fs-1"></i>
            </div>
            <h4 class="fw-bold">الطلب غير موجود</h4>
            <p class="text-muted small mb-4">الطلب رقم @OrderNumber غير موجود</p>
            <NavLink href="/" class="btn btn-dark px-4 shadow-sm">ارجع</NavLink>
        </div>
    }
}
else
{
    <div class="position-absolute top-50 start-50 translate-middle text-center">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}


@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "num")]
    public string OrderNumber { get; set; } = null!;
    private OrderRequestDTO OrderRequest { get; set; } = null!;
    private bool IsBusy { get; set; }
    private string? ErrorMsg { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsBusy = true;

        var authResponse = await AuthService.VerifyAdminAsync();
        AdminStateManager.IsLoggedIn = authResponse.Data;

        if (!AdminStateManager.IsLoggedIn)
        {
            IsBusy = false;
            Nav.NavigateTo("/login");
            return;
        }

        var response = await OrderService.GetOrderAdminAsync(OrderNumber);

        if (!response.IsSuccess)
        {
            IsBusy = false;
            ErrorMsg = response.ErrorMessage;
            return;
        }

        OrderRequest = response.Data;

        IsBusy = false;
    }

    private string GetStatusBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Processing => "bg-info text-white",
        OrderStatus.Delivered => "bg-primary text-white",
        OrderStatus.Completed => "bg-success text-white",
        OrderStatus.Cancelled => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };
}
